[Unit]
Description=Publish verified Facebook supplement candidates through existing local admission
After=umraniye-osint-deneme.service
[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/umraniye-osint-facebook-fbgql-deneme/backup_publish.py
TimeoutStartSec=90
UMask=0077
MemoryMax=120M
TasksMax=16
Nice=10
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/umraniye-osint-facebook-supplement
ReadOnlyPaths=/var/lib/umraniye-osint-facebook-fbgql-deneme /var/lib/umraniye-osint-deneme
InaccessiblePaths=-/var/lib/umraniye-osint-facebook-fbgql-deneme/accounts.sqlite -/var/lib/umraniye-osint-browser -/opt/umraniye-osint-browser
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
