[Unit]
Description=Umraniye medya arsivi (OSINT'ten ayri)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/umraniye-medya/deploy
ExecStart=/bin/bash /opt/umraniye-medya/deploy/medya.sh up -d --no-build
ExecStop=/bin/bash /opt/umraniye-medya/deploy/medya.sh stop
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
