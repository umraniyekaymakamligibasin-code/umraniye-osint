[Unit]
Description=Umraniye OSINT kurum yonlendirme turu (case + outbox uretimi)
Documentation=file:/opt/umraniye-osint-deneme/server/institution-coordination/kurum/README-KURUM.txt
After=network-online.target umraniye-osint-deneme.service
Wants=umraniye-osint-deneme.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=osintdeneme
Group=osintdeneme
UMask=0077
WorkingDirectory=/opt/umraniye-osint-deneme
EnvironmentFile=/etc/umraniye-osint-deneme.env
Environment=DATA_DIR=/var/lib/umraniye-osint-deneme
# Ilce kapsamli olaylari (scope='local') ILCE duzeyinde dogrulanmis say.
# Mahalle bilgisi kuruma TASINMAZ; yalnizca ilce duzeyi kullanilir.
# Bu mod yalnizca zamanlayici biriminde aciktir; ana uygulamayi etkilemez.
Environment=OSINT_ROUTING_LOCAL_SCOPE=1
ExecStart=/opt/node-v24.22.1-linux-x64/bin/node --max-old-space-size=256 /opt/umraniye-osint-deneme/server/institution-coordination/kurum/kurum-zamanlayici.mjs --tek-sefer --sunucu /opt/umraniye-osint-deneme
Restart=no
TimeoutStartSec=300
MemoryHigh=192M
MemoryMax=320M
TasksMax=32
Nice=10
CPUQuota=40%
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/umraniye-osint-deneme

[Install]
WantedBy=multi-user.target
